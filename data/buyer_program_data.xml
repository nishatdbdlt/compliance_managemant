<odoo noupdate="1">

    <record id="buyer_org_amfori" model="compliance.buyer"><field name="name">amfori BSCI</field><field name="code">AMFORI-BSCI</field><field name="company_id" ref="base.main_company"/><field name="notes">Audit organization/program reference for BSCI audits.</field></record>
    <record id="buyer_org_wrap" model="compliance.buyer"><field name="name">WRAP</field><field name="code">WRAP</field><field name="company_id" ref="base.main_company"/><field name="notes">Audit organization/program reference for WRAP audits.</field></record>
    <record id="buyer_org_sedex" model="compliance.buyer"><field name="name">SEDEX / SMETA</field><field name="code">SEDEX-SMETA</field><field name="company_id" ref="base.main_company"/><field name="notes">Audit organization/program reference for SEDEX / SMETA audits.</field></record>

    <record id="standard_bsci" model="compliance.standard">
        <field name="name">amfori BSCI Social Compliance</field><field name="code">BSCI</field><field name="program_type">bsci</field><field name="category">labor</field><field name="company_id" ref="base.main_company"/>
        <field name="description">Starter checklist for social compliance audits aligned to common BSCI audit areas. Adapt to the current official standard and buyer requirements before live certification use.</field>
    </record>
    <record id="standard_wrap" model="compliance.standard">
        <field name="name">WRAP Social Compliance</field><field name="code">WRAP</field><field name="program_type">wrap</field><field name="category">labor</field><field name="company_id" ref="base.main_company"/>
        <field name="description">Starter WRAP-oriented factory social compliance checklist. Review against the current official program before certification audits.</field>
    </record>
    <record id="standard_sedex" model="compliance.standard">
        <field name="name">SEDEX / SMETA Social Audit</field><field name="code">SMETA</field><field name="program_type">sedex</field><field name="category">labor</field><field name="company_id" ref="base.main_company"/>
        <field name="description">Starter SEDEX/SMETA-oriented checklist covering labor, health and safety, environment and business ethics.</field>
    </record>
    <record id="standard_buyer_general" model="compliance.standard">
        <field name="name">General Buyer Audit Checklist</field><field name="code">BUYER-GEN</field><field name="program_type">buyer</field><field name="category">buyer</field><field name="company_id" ref="base.main_company"/>
        <field name="description">Editable general buyer audit checklist for customer-specific factory compliance assessments.</field>
    </record>

    <!-- BSCI starter items -->
    <record id="bsci_01" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">10</field><field name="name">No Child Labor</field><field name="category">labor</field><field name="requirement">Verify all workers meet legal minimum age requirements and reliable age documents are maintained.</field><field name="guidance">Check personnel files, ID/age records, recruitment controls and worker interviews.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="bsci_02" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">20</field><field name="name">No Forced Labor</field><field name="category">labor</field><field name="requirement">Employment must be voluntary with no retention of original documents, deposits or coercive practices.</field><field name="guidance">Interview workers and review recruitment, resignation and document-handling practices.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="bsci_03" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">30</field><field name="name">Working Hours Control</field><field name="category">labor</field><field name="requirement">Working hours, overtime and rest days comply with applicable law and approved limits.</field><field name="guidance">Compare attendance, production and payroll records for consistency.</field><field name="severity">high</field><field name="weight">2</field></record>
    <record id="bsci_04" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">40</field><field name="name">Wages and Benefits</field><field name="category">labor</field><field name="requirement">Workers receive legal wages, overtime premiums and statutory benefits accurately and on time.</field><field name="guidance">Review payroll, payslips, bank/cash records and benefit evidence.</field><field name="severity">high</field><field name="weight">2</field></record>
    <record id="bsci_05" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">50</field><field name="name">Fire and Emergency Preparedness</field><field name="category">health</field><field name="requirement">Fire detection, alarms, extinguishers, exits, evacuation plans and drills are adequate and maintained.</field><field name="guidance">Inspect exits, fire equipment, signage, drill records and emergency teams.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="bsci_06" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">60</field><field name="name">Grievance Mechanism</field><field name="category">labor</field><field name="requirement">Workers have confidential and non-retaliatory channels to raise grievances.</field><field name="guidance">Check policy, complaint boxes/hotline, case log and worker awareness.</field><field name="severity">medium</field></record>
    <record id="bsci_07" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">70</field><field name="name">No Discrimination or Harassment</field><field name="category">labor</field><field name="requirement">Recruitment, pay, promotion and discipline are free from unlawful discrimination, abuse and harassment.</field><field name="guidance">Review policies, cases, interviews and disciplinary records.</field><field name="severity">high</field></record>
    <record id="bsci_08" model="compliance.checklist"><field name="standard_id" ref="standard_bsci"/><field name="sequence">80</field><field name="name">Environmental Controls</field><field name="category">environment</field><field name="requirement">Required environmental permits, waste controls and chemical management practices are maintained.</field><field name="guidance">Check permits, waste manifests, chemical inventory/SDS and storage.</field><field name="severity">medium</field></record>

    <!-- WRAP starter items -->
    <record id="wrap_01" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">10</field><field name="name">Compliance with Laws and Workplace Regulations</field><field name="category">documentation</field><field name="requirement">Factory maintains applicable legal registrations, permits and workplace compliance records.</field><field name="guidance">Review legal register, licenses and renewal controls.</field><field name="severity">high</field></record>
    <record id="wrap_02" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">20</field><field name="name">Prohibition of Forced Labor</field><field name="category">labor</field><field name="requirement">No prison, indentured, bonded or otherwise forced labor is used.</field><field name="guidance">Worker interviews, recruitment agency controls and personnel records.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="wrap_03" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">30</field><field name="name">Prohibition of Child Labor</field><field name="category">labor</field><field name="requirement">No worker below the legal minimum age is employed.</field><field name="guidance">Age verification files and recruitment process.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="wrap_04" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">40</field><field name="name">Compensation and Benefits</field><field name="category">labor</field><field name="requirement">Compensation and benefits satisfy legal and contractual requirements.</field><field name="guidance">Payroll samples, overtime rates, deductions and benefits.</field><field name="severity">high</field></record>
    <record id="wrap_05" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">50</field><field name="name">Hours of Work</field><field name="category">labor</field><field name="requirement">Normal and overtime hours are recorded accurately and controlled.</field><field name="guidance">Attendance, overtime approvals and rest-day evidence.</field><field name="severity">high</field></record>
    <record id="wrap_06" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">60</field><field name="name">Health and Safety</field><field name="category">health</field><field name="requirement">A safe and healthy workplace is maintained with appropriate emergency, machinery and PPE controls.</field><field name="guidance">Physical inspection, risk assessments, training and incident records.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="wrap_07" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">70</field><field name="name">Customs / Facility Security</field><field name="category">buyer</field><field name="requirement">Site access, cargo, visitor and shipment security controls are documented and followed.</field><field name="guidance">Check access logs, guard controls, loading areas and seal procedures.</field><field name="severity">high</field></record>
    <record id="wrap_08" model="compliance.checklist"><field name="standard_id" ref="standard_wrap"/><field name="sequence">80</field><field name="name">Environment</field><field name="category">environment</field><field name="requirement">Environmental laws and factory controls for waste, emissions and chemicals are followed.</field><field name="guidance">Permits, testing records, waste handling and storage.</field><field name="severity">medium</field></record>

    <!-- SEDEX / SMETA starter items -->
    <record id="sedex_01" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">10</field><field name="name">Employment Freely Chosen</field><field name="category">labor</field><field name="requirement">Workers are employed voluntarily and can leave employment according to lawful notice terms.</field><field name="guidance">Contracts, interviews, recruitment fees and document retention.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="sedex_02" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">20</field><field name="name">Freedom of Association</field><field name="category">labor</field><field name="requirement">Worker representation and lawful freedom of association rights are respected.</field><field name="guidance">Worker committees, election records and interviews.</field><field name="severity">medium</field></record>
    <record id="sedex_03" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">30</field><field name="name">Safe and Hygienic Conditions</field><field name="category">health</field><field name="requirement">Workplace, welfare facilities and emergency systems provide safe and hygienic conditions.</field><field name="guidance">Physical tour, risk assessment, first aid, PPE and welfare facilities.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="sedex_04" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">40</field><field name="name">Child Labor Prevention</field><field name="category">labor</field><field name="requirement">Child labor is prohibited and young workers are protected according to law.</field><field name="guidance">Age records, young worker register and remediation process.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="sedex_05" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">50</field><field name="name">Living Wages / Legal Wages</field><field name="category">labor</field><field name="requirement">Wages and benefits meet at least applicable legal and contractual requirements.</field><field name="guidance">Payroll, overtime premium, deductions and worker interviews.</field><field name="severity">high</field></record>
    <record id="sedex_06" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">60</field><field name="name">Working Hours</field><field name="category">labor</field><field name="requirement">Working hours and overtime are controlled, recorded and consistent with legal requirements.</field><field name="guidance">Cross-check attendance, payroll and production records.</field><field name="severity">high</field></record>
    <record id="sedex_07" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">70</field><field name="name">Environment Assessment</field><field name="category">environment</field><field name="requirement">Key environmental impacts, permits, waste and resource controls are monitored.</field><field name="guidance">Environmental permits, waste data, energy/water records and chemical controls.</field><field name="severity">medium</field></record>
    <record id="sedex_08" model="compliance.checklist"><field name="standard_id" ref="standard_sedex"/><field name="sequence">80</field><field name="name">Business Ethics</field><field name="category">ethics</field><field name="requirement">Controls exist against bribery, corruption, falsification and improper business practices.</field><field name="guidance">Policies, training, whistleblowing channels and case records.</field><field name="severity">high</field></record>

    <!-- General buyer starter items -->
    <record id="buyer_01" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">10</field><field name="name">Legal Licenses Valid</field><field name="category">documentation</field><field name="requirement">Required factory, trade, fire, environmental and other legal licenses are current.</field><field name="guidance">Check original/verified licenses and expiry dates.</field><field name="severity">critical</field></record>
    <record id="buyer_02" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">20</field><field name="name">Emergency Exits Clear</field><field name="category">health</field><field name="requirement">Emergency routes and exits remain unlocked, unobstructed and properly marked during occupancy.</field><field name="guidance">Physical verification across all production and storage floors.</field><field name="severity">critical</field><field name="weight">2</field></record>
    <record id="buyer_03" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">30</field><field name="name">PPE Use and Availability</field><field name="category">health</field><field name="requirement">Required PPE is provided free of charge and used in identified risk areas.</field><field name="guidance">Observe workstations and verify issue/training records.</field><field name="severity">high</field></record>
    <record id="buyer_04" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">40</field><field name="name">Chemical Safety</field><field name="category">health</field><field name="requirement">Chemicals are labeled, stored safely and supported by current safety data sheets.</field><field name="guidance">Chemical store, secondary containment, SDS and training.</field><field name="severity">high</field></record>
    <record id="buyer_05" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">50</field><field name="name">Employee Contracts and Files</field><field name="category">labor</field><field name="requirement">Employee files contain required contracts, identification and employment records.</field><field name="guidance">Sample employee files across departments and worker categories.</field><field name="severity">medium</field></record>
    <record id="buyer_06" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">60</field><field name="name">Payroll Accuracy</field><field name="category">labor</field><field name="requirement">Payroll calculations, overtime and deductions match attendance and approved rates.</field><field name="guidance">Trace sample workers from attendance through payroll and payment proof.</field><field name="severity">high</field></record>
    <record id="buyer_07" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">70</field><field name="name">Compliance Training Records</field><field name="category">documentation</field><field name="requirement">Required safety, rights, ethics and job-specific compliance training is recorded.</field><field name="guidance">Training matrix, attendance, content and competency evidence.</field><field name="severity">medium</field></record>
    <record id="buyer_08" model="compliance.checklist"><field name="standard_id" ref="standard_buyer_general"/><field name="sequence">80</field><field name="name">CAPA Closure Effectiveness</field><field name="category">buyer</field><field name="requirement">Previous audit corrective actions were completed and verified for effectiveness.</field><field name="guidance">Sample prior findings, evidence and recurrence history.</field><field name="severity">high</field></record>
</odoo>
