<odoo>
    <data noupdate="1">
        <record id="seq_compliance_audit" model="ir.sequence">
            <field name="name">Compliance Audit</field><field name="code">compliance.audit</field>
            <field name="prefix">AUD/%(year)s/</field><field name="padding">4</field>
        </record>
        <record id="seq_compliance_finding" model="ir.sequence">
            <field name="name">Compliance Finding</field><field name="code">compliance.finding</field>
            <field name="prefix">FND/%(year)s/</field><field name="padding">4</field>
        </record>
        <record id="seq_compliance_capa" model="ir.sequence">
            <field name="name">Compliance CAPA</field><field name="code">compliance.capa</field>
            <field name="prefix">CAPA/%(year)s/</field><field name="padding">4</field>
        </record>
        <record id="seq_compliance_safety" model="ir.sequence">
            <field name="name">Safety Inspection</field><field name="code">compliance.safety</field>
            <field name="prefix">SAF/%(year)s/</field><field name="padding">4</field>
        </record>
    </data>
</odoo>
