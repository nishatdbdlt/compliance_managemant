<odoo noupdate="1">
    <record id="checklist_bd_factory_starter" model="garment.compliance.checklist.template">
        <field name="name">Bangladesh Garments Starter - Factory Compliance</field>
        <field name="code">BD-GAR-STARTER</field>
        <field name="country_code">BD</field>
        <field name="audit_type">internal</field>
        <field name="notes"><![CDATA[
            <p>Starter checklist only. Review every question and configure thresholds against the current applicable Bangladesh requirements, buyer code of conduct, certification standard, and factory policy before operational use.</p>
        ]]></field>
    </record>

    <record id="check_bd_01" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">10</field><field name="section">Worker Documentation</field><field name="question">Worker identity and age-verification evidence is available and traceable.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_02" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">20</field><field name="section">Worker Documentation</field><field name="question">Employment terms / appointment documentation is available for sampled workers.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
    <record id="check_bd_03" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">30</field><field name="section">Working Hours</field><field name="question">Attendance records are complete, traceable, and consistent with the source system.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
    <record id="check_bd_04" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">40</field><field name="section">Working Hours</field><field name="question">Overtime records were checked against the configured law / buyer / company thresholds.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
    <record id="check_bd_05" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">50</field><field name="section">Working Hours</field><field name="question">Weekly rest and continuous-work patterns were reviewed for the audit period.</field><field name="severity">major</field></record>
    <record id="check_bd_06" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">60</field><field name="section">Wages</field><field name="question">Wage records match attendance / overtime records for sampled workers.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_07" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">70</field><field name="section">Wages</field><field name="question">Configured wage and overtime-payment checks were completed for the period.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_08" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">80</field><field name="section">Worker Voice</field><field name="question">A worker grievance channel exists and open grievances have owners / follow-up.</field><field name="severity">major</field></record>
    <record id="check_bd_09" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">90</field><field name="section">Fire Safety</field><field name="question">Emergency exits and evacuation routes are accessible and unobstructed.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_10" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">100</field><field name="section">Fire Safety</field><field name="question">Fire-fighting / alarm equipment inspection records are current under the configured inspection plan.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_11" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">110</field><field name="section">Fire Safety</field><field name="question">Emergency drill records, headcount results, observations, and corrective actions are available.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
    <record id="check_bd_12" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">120</field><field name="section">Electrical / Machine Safety</field><field name="question">Electrical panels / installations and machine safeguards are covered by documented inspection checks.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_13" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">130</field><field name="section">Health &amp; Safety</field><field name="question">Required PPE, first-aid arrangements, and incident / near-miss records are maintained.</field><field name="severity">major</field></record>
    <record id="check_bd_14" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">140</field><field name="section">Chemical Management</field><field name="question">Chemicals are identified and SDS / MSDS records are available where applicable.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
    <record id="check_bd_15" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">150</field><field name="section">Chemical Management</field><field name="question">Chemical storage, labeling, PPE requirements, and approval status are controlled.</field><field name="severity">major</field></record>
    <record id="check_bd_16" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">160</field><field name="section">Environment</field><field name="question">Applicable wastewater / ETP / emissions / waste monitoring records are available and reviewed.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
    <record id="check_bd_17" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">170</field><field name="section">Licenses &amp; Certificates</field><field name="question">Applicable licenses, certificates, and inspection documents are tracked with expiry / renewal dates.</field><field name="severity">critical</field><field name="evidence_required">1</field></record>
    <record id="check_bd_18" model="garment.compliance.checklist.template.line"><field name="template_id" ref="checklist_bd_factory_starter"/><field name="sequence">180</field><field name="section">CAPA</field><field name="question">Open audit findings have root cause, responsible owner, due date, evidence, and verification status.</field><field name="severity">major</field><field name="evidence_required">1</field></record>
</odoo>
