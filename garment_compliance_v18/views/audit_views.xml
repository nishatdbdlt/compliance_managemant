<odoo>
 <record id="view_audit_list" model="ir.ui.view"><field name="name">garment.compliance.audit.list</field><field name="model">garment.compliance.audit</field><field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="audit_type"/><field name="buyer_id"/><field name="template_id"/><field name="audit_date"/><field name="next_audit_date"/><field name="auditor_id"/><field name="score"/><field name="state"/></list></field></record>
 <record id="view_audit_form" model="ir.ui.view"><field name="name">garment.compliance.audit.form</field><field name="model">garment.compliance.audit</field><field name="arch" type="xml"><form><header><button name="action_load_template" string="Load Checklist" type="object" class="btn-secondary" invisible="not template_id or state not in ['planned','scheduled']"/><button name="action_next" string="Next Stage" type="object" class="btn-primary" invisible="state == 'closed'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1><field name="reference"/></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="audit_type"/><field name="buyer_id"/><field name="template_id" domain="['&amp;', '|', ('company_id','=',False), ('company_id','=',company_id), '|', ('buyer_id','=',False), ('buyer_id','=',buyer_id)]"/><field name="department_id"/><field name="auditor_id"/></group><group><field name="audit_date"/><field name="next_audit_date"/><field name="score"/></group></group><notebook><page string="Checklist"><field name="line_ids"><list editable="bottom" decoration-danger="result == 'no'"><field name="sequence" widget="handle"/><field name="section"/><field name="question"/><field name="severity"/><field name="evidence_required" optional="hide"/><field name="result"/><field name="observation"/></list></field></page><page string="Findings"><field name="finding_ids"><list><field name="name"/><field name="severity"/><field name="responsible_id"/><field name="due_date"/><field name="state"/></list></field></page><page string="Reports"><field name="report_attachment_ids" widget="many2many_binary"/></page><page string="Notes"><field name="notes"/></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_audit" model="ir.actions.act_window"><field name="name">Audits</field><field name="res_model">garment.compliance.audit</field><field name="view_mode">list,form,graph,pivot</field></record>
 <record id="view_finding_list" model="ir.ui.view"><field name="name">garment.compliance.finding.list</field><field name="model">garment.compliance.finding</field><field name="arch" type="xml"><list decoration-danger="severity == 'critical'"><field name="name"/><field name="audit_id"/><field name="severity"/><field name="responsible_id"/><field name="due_date"/><field name="state"/></list></field></record>
 <record id="view_finding_form" model="ir.ui.view"><field name="name">garment.compliance.finding.form</field><field name="model">garment.compliance.finding</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="audit_id"/><field name="category"/><field name="severity"/></group><group><field name="responsible_id"/><field name="due_date"/><field name="state"/></group></group><notebook><page string="Observation"><field name="observation"/><field name="root_cause"/></page><page string="CAPA"><field name="capa_ids"><list><field name="reference"/><field name="name"/><field name="responsible_id"/><field name="due_date"/><field name="state"/></list></field></page><page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_finding" model="ir.actions.act_window"><field name="name">Audit Findings</field><field name="res_model">garment.compliance.finding</field><field name="view_mode">list,form</field></record>
</odoo>
