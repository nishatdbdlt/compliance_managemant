<odoo>
 <record id="view_capa_list" model="ir.ui.view"><field name="name">garment.compliance.capa.list</field><field name="model">garment.compliance.capa</field><field name="arch" type="xml"><list><field name="reference"/><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="finding_id"/><field name="severity"/><field name="responsible_id"/><field name="due_date"/><field name="state"/></list></field></record>
 <record id="view_capa_form" model="ir.ui.view"><field name="name">garment.compliance.capa.form</field><field name="model">garment.compliance.capa</field><field name="arch" type="xml"><form><header><button name="action_progress" string="Start" type="object" invisible="state != 'open'"/><button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'progress'"/><button name="action_verify" string="Verify" type="object" groups="garment_compliance_v18.group_compliance_manager" invisible="state != 'submitted'"/><button name="action_close" string="Close" type="object" groups="garment_compliance_v18.group_compliance_manager" invisible="state != 'verified'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1><field name="reference"/></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="finding_id" domain="['|',('company_id','=',False),('company_id','=',company_id)]"/><field name="responsible_id"/><field name="due_date"/></group><group><field name="severity"/><field name="verified_by" readonly="1"/><field name="verification_date" readonly="1"/></group></group><notebook><page string="Root Cause &amp; Actions"><field name="root_cause"/><field name="corrective_action"/><field name="preventive_action"/></page><page string="Evidence"><field name="evidence_ids" widget="many2many_binary"/></page></notebook></sheet><chatter/></form></field></record>
 <record id="action_capa" model="ir.actions.act_window"><field name="name">Corrective Actions (CAPA)</field><field name="res_model">garment.compliance.capa</field><field name="view_mode">list,form,graph,pivot</field></record>
</odoo>
