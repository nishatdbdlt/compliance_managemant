<odoo>
 <record id="view_certificate_list" model="ir.ui.view"><field name="name">garment.compliance.certificate.list</field><field name="model">garment.compliance.certificate</field><field name="arch" type="xml"><list decoration-danger="state == 'expired'" decoration-warning="state == 'expiring'" decoration-success="state == 'valid'"><field name="name"/><field name="certificate_no"/><field name="category"/><field name="authority"/><field name="expiry_date"/><field name="responsible_id"/><field name="state"/></list></field></record>
 <record id="view_certificate_form" model="ir.ui.view"><field name="name">garment.compliance.certificate.form</field><field name="model">garment.compliance.certificate</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="certificate_no"/><field name="category"/><field name="authority"/><field name="company_id" groups="base.group_multi_company"/></group><group><field name="issue_date"/><field name="expiry_date"/><field name="responsible_id"/><field name="state"/></group></group><field name="attachment_ids" widget="many2many_binary"/></sheet><chatter/></form></field></record>
 <record id="action_certificate" model="ir.actions.act_window"><field name="name">Licenses &amp; Certificates</field><field name="res_model">garment.compliance.certificate</field><field name="view_mode">list,form</field></record>
</odoo>
