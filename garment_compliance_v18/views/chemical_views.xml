<odoo>
 <record id="view_chemical_list" model="ir.ui.view"><field name="name">garment.compliance.chemical.list</field><field name="model">garment.compliance.chemical</field><field name="arch" type="xml"><list decoration-danger="approval_status == 'banned'" decoration-warning="approval_status in ['restricted','pending']"><field name="name"/><field name="supplier_id"/><field name="hazard_class"/><field name="storage_location"/><field name="approval_status"/><field name="expiry_date"/></list></field></record>
 <record id="view_chemical_form" model="ir.ui.view"><field name="name">garment.compliance.chemical.form</field><field name="model">garment.compliance.chemical</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="supplier_id"/><field name="hazard_class"/><field name="storage_location"/><field name="approval_status"/><field name="expiry_date"/></group><field name="ppe_requirement"/><field name="sds_attachment_ids" widget="many2many_binary"/><field name="notes"/></sheet><chatter/></form></field></record>
 <record id="action_chemical" model="ir.actions.act_window"><field name="name">Chemical Register</field><field name="res_model">garment.compliance.chemical</field><field name="view_mode">list,form</field></record>
</odoo>
