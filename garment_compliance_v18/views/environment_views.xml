 <record id="view_environment_list" model="ir.ui.view"><field name="name">garment.compliance.environment.list</field><field name="model">garment.compliance.environment</field><field name="arch" type="xml"><list decoration-danger="result == 'fail'"><field name="date"/><field name="name"/><field name="monitoring_type"/><field name="value"/><field name="unit"/><field name="limit_value"/><field name="result"/><field name="responsible_id"/></list></field></record>
