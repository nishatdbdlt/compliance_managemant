<odoo>
    <data noupdate="1">
        <record id="ir_cron_compliance_overdue_findings" model="ir.cron">
            <field name="name">Compliance: Overdue Finding Activities</field>
            <field name="model_id" ref="model_compliance_finding"/>
            <field name="state">code</field>
            <field name="code">model._cron_overdue_activities()</field>
            <field name="interval_number">1</field><field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_compliance_license_expiry" model="ir.cron">
            <field name="name">Compliance: License Expiry Activities</field>
            <field name="model_id" ref="model_compliance_license"/>
            <field name="state">code</field>
            <field name="code">model._cron_expiry_activities()</field>
            <field name="interval_number">1</field><field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
