<odoo>
    <data noupdate="1">
        <record id="grade_a" model="compliance.grade.rule">
            <field name="name">A</field><field name="min_score">90</field><field name="max_score">100</field>
            <field name="description">Excellent compliance</field><field name="company_id" ref="base.main_company"/>
        </record>
        <record id="grade_b" model="compliance.grade.rule">
            <field name="name">B</field><field name="min_score">80</field><field name="max_score">89.99</field>
            <field name="description">Good compliance</field><field name="company_id" ref="base.main_company"/>
        </record>
        <record id="grade_c" model="compliance.grade.rule">
            <field name="name">C</field><field name="min_score">70</field><field name="max_score">79.99</field>
            <field name="description">Conditional compliance</field><field name="company_id" ref="base.main_company"/>
        </record>
        <record id="grade_d" model="compliance.grade.rule">
            <field name="name">D</field><field name="min_score">0</field><field name="max_score">69.99</field>
            <field name="description">Needs major improvement</field><field name="company_id" ref="base.main_company"/>
        </record>
    </data>
</odoo>
