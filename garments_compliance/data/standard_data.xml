<odoo>
    <data noupdate="1">
        <record id="standard_general_garments" model="compliance.standard">
            <field name="name">General Garments Compliance Standard</field>
            <field name="code">GGC</field>
            <field name="program_type">general</field>
            <field name="category">other</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="description">Starter checklist covering common labor, safety, environmental, ethics and documentation controls. Review and adapt it to buyer and legal requirements before use.</field>
        </record>

        <record id="checklist_001" model="compliance.checklist"><field name="sequence">10</field><field name="name">Valid worker age documentation</field><field name="standard_id" ref="standard_general_garments"/><field name="category">labor</field><field name="requirement">Worker age and identity records are available and no underage worker is employed.</field><field name="guidance">Review personnel files, ID/age evidence and recruitment controls.</field><field name="severity">critical</field><field name="weight">1.0</field></record>
        <record id="checklist_002" model="compliance.checklist"><field name="sequence">20</field><field name="name">Working hours and overtime</field><field name="standard_id" ref="standard_general_garments"/><field name="category">labor</field><field name="requirement">Working hours, rest days and overtime are recorded and controlled according to applicable requirements.</field><field name="guidance">Sample attendance, payroll and overtime approvals.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_003" model="compliance.checklist"><field name="sequence">30</field><field name="name">Wages and benefits</field><field name="standard_id" ref="standard_general_garments"/><field name="category">labor</field><field name="requirement">Workers receive applicable wages, benefits and overtime payments with understandable records.</field><field name="guidance">Compare payroll, bank/payment evidence and attendance.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_004" model="compliance.checklist"><field name="sequence">40</field><field name="name">No forced labor</field><field name="standard_id" ref="standard_general_garments"/><field name="category">labor</field><field name="requirement">Employment is voluntary and worker identity documents are not improperly retained.</field><field name="guidance">Interview workers and review recruitment/exit practices.</field><field name="severity">critical</field><field name="weight">1.0</field></record>
        <record id="checklist_005" model="compliance.checklist"><field name="sequence">50</field><field name="name">Emergency exits unobstructed</field><field name="standard_id" ref="standard_general_garments"/><field name="category">health</field><field name="requirement">Emergency exits, routes and stairways are unlocked, clearly marked and unobstructed during occupancy.</field><field name="guidance">Physically inspect all exit routes and exit doors.</field><field name="severity">critical</field><field name="weight">1.0</field></record>
        <record id="checklist_006" model="compliance.checklist"><field name="sequence">60</field><field name="name">Fire equipment readiness</field><field name="standard_id" ref="standard_general_garments"/><field name="category">health</field><field name="requirement">Fire detection, alarm and firefighting equipment is available, accessible and maintained.</field><field name="guidance">Inspect equipment tags, test records and accessibility.</field><field name="severity">critical</field><field name="weight">1.0</field></record>
        <record id="checklist_007" model="compliance.checklist"><field name="sequence">70</field><field name="name">Emergency drills and training</field><field name="standard_id" ref="standard_general_garments"/><field name="category">health</field><field name="requirement">Emergency drills and relevant safety training are conducted and documented.</field><field name="guidance">Review drill reports, attendance and corrective actions.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_008" model="compliance.checklist"><field name="sequence">80</field><field name="name">Machine guarding</field><field name="standard_id" ref="standard_general_garments"/><field name="category">health</field><field name="requirement">Machine guards and safety devices are installed and functional where required.</field><field name="guidance">Inspect representative production machines.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_009" model="compliance.checklist"><field name="sequence">90</field><field name="name">PPE availability and use</field><field name="standard_id" ref="standard_general_garments"/><field name="category">health</field><field name="requirement">Required personal protective equipment is provided, suitable and used.</field><field name="guidance">Observe work areas and verify issue/training records.</field><field name="severity">medium</field><field name="weight">1.0</field></record>
        <record id="checklist_010" model="compliance.checklist"><field name="sequence">100</field><field name="name">Chemical storage and SDS</field><field name="standard_id" ref="standard_general_garments"/><field name="category">environment</field><field name="requirement">Chemicals are labeled, stored safely and supported by current safety data sheets.</field><field name="guidance">Inspect chemical stores and point-of-use locations.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_011" model="compliance.checklist"><field name="sequence">110</field><field name="name">Waste management</field><field name="standard_id" ref="standard_general_garments"/><field name="category">environment</field><field name="requirement">Waste is identified, segregated, stored and disposed through appropriate controls.</field><field name="guidance">Inspect waste areas and disposal records.</field><field name="severity">medium</field><field name="weight">1.0</field></record>
        <record id="checklist_012" model="compliance.checklist"><field name="sequence">120</field><field name="name">Environmental permits and monitoring</field><field name="standard_id" ref="standard_general_garments"/><field name="category">environment</field><field name="requirement">Applicable environmental permits are valid and required monitoring records are maintained.</field><field name="guidance">Review permits, test reports and renewal tracking.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_013" model="compliance.checklist"><field name="sequence">130</field><field name="name">Anti-harassment and grievance process</field><field name="standard_id" ref="standard_general_garments"/><field name="category">ethics</field><field name="requirement">Workers have access to a communicated grievance process and anti-harassment controls.</field><field name="guidance">Review policy, awareness records, complaint channels and sample case handling.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_014" model="compliance.checklist"><field name="sequence">140</field><field name="name">Business ethics policy</field><field name="standard_id" ref="standard_general_garments"/><field name="category">ethics</field><field name="requirement">A relevant ethics/anti-bribery policy is communicated to responsible personnel.</field><field name="guidance">Review policy, training and acknowledgment records.</field><field name="severity">medium</field><field name="weight">1.0</field></record>
        <record id="checklist_015" model="compliance.checklist"><field name="sequence">150</field><field name="name">Required licenses are current</field><field name="standard_id" ref="standard_general_garments"/><field name="category">documentation</field><field name="requirement">Applicable factory, fire, trade, environmental and other required licenses/certificates are current.</field><field name="guidance">Cross-check the license register and source documents.</field><field name="severity">high</field><field name="weight">1.0</field></record>
        <record id="checklist_016" model="compliance.checklist"><field name="sequence">160</field><field name="name">Policies and procedures controlled</field><field name="standard_id" ref="standard_general_garments"/><field name="category">documentation</field><field name="requirement">Compliance policies and procedures have owners, versions, approval and review dates.</field><field name="guidance">Sample controlled documents and compare with the document register.</field><field name="severity">medium</field><field name="weight">1.0</field></record>
    </data>
</odoo>
