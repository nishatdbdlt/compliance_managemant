<odoo>
    <record id="view_compliance_audit_search" model="ir.ui.view">
        <field name="name">compliance.audit.search</field><field name="model">compliance.audit</field>
        <field name="arch" type="xml"><search><field name="name"/><field name="factory_id"/><field name="buyer_id"/><field name="program_type"/><field name="standard_id"/><field name="auditor_id"/><filter name="active_audits" string="Active" domain="[('state','not in',('closed','cancelled'))]"/><filter name="closed" string="Closed" domain="[('state','=','closed')]"/><separator/><filter name="group_factory" string="Factory" context="{'group_by':'factory_id'}"/><filter name="group_grade" string="Grade" context="{'group_by':'grade'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/></search></field>
    </record>
    <record id="view_compliance_audit_list" model="ir.ui.view">
        <field name="name">compliance.audit.list</field><field name="model">compliance.audit</field>
        <field name="arch" type="xml"><list decoration-success="grade == 'A'" decoration-warning="grade in ('B','C')" decoration-danger="grade == 'D'"><field name="name"/><field name="audit_date"/><field name="factory_id"/><field name="buyer_id"/><field name="program_type"/><field name="standard_id"/><field name="compliance_rate"/><field name="grade" widget="badge"/><field name="result" widget="badge"/><field name="open_finding_count"/><field name="state" widget="badge"/></list></field>
    </record>
    <record id="view_compliance_audit_form" model="ir.ui.view">
        <field name="name">compliance.audit.form</field><field name="model">compliance.audit</field>
        <field name="arch" type="xml">
            <form string="Compliance Audit">
                <header>
                    <button name="action_load_checklist" type="object" string="Load Checklist" invisible="state not in ('draft','scheduled')"/>
                    <button name="action_schedule" type="object" string="Schedule" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start Audit" class="btn-primary" invisible="state != 'scheduled'"/>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_review" type="object" string="Review" class="btn-primary" invisible="state != 'submitted'" groups="garments_compliance.group_compliance_manager"/>
                    <button name="action_close" type="object" string="Close Audit" class="btn-primary" invisible="state != 'reviewed'" groups="garments_compliance.group_compliance_manager"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft','scheduled','in_progress')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" invisible="state != 'cancelled'" groups="garments_compliance.group_compliance_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,scheduled,in_progress,submitted,reviewed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="action" name="%(action_compliance_finding)d" icon="fa-exclamation-triangle" context="{'search_default_audit_id': id}"><field name="open_finding_count" string="Open Findings" widget="statinfo"/></button>
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group><field name="company_id" groups="base.group_multi_company"/><field name="audit_type"/><field name="program_type" readonly="1"/><field name="standard_id" options="{'no_create': True}"/><field name="buyer_id" invisible="audit_type != 'buyer'"/><field name="factory_id"/></group>
                        <group><field name="audit_date"/><field name="auditor_id"/><field name="reviewer_id" readonly="1"/><field name="result" widget="badge" readonly="1"/></group>
                    </group>
                    <group string="Audit Result">
                        <field name="compliance_rate" widget="progressbar" readonly="1"/><field name="grade" widget="badge" readonly="1"/><field name="total_items" readonly="1"/><field name="completed_items" readonly="1"/><field name="compliant_items" readonly="1"/><field name="partial_items" readonly="1"/><field name="noncompliant_items" readonly="1"/><field name="na_items" readonly="1"/><field name="critical_finding_count" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Checklist">
                            <field name="checklist_line_ids" readonly="state in ('submitted','reviewed','closed','cancelled')">
                                <list editable="bottom" decoration-success="result == 'compliant'" decoration-warning="result == 'partial'" decoration-danger="result == 'non_compliant'" decoration-muted="result == 'na'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="category" optional="show"/>
                                    <field name="requirement" optional="show"/>
                                    <field name="guidance" optional="show"/>
                                    <field name="severity"/>
                                    <field name="weight" optional="hide"/>
                                    <field name="mandatory" optional="show"/>
                                    <field name="result"/>
                                    <field name="remarks"/>
                                    <field name="evidence" filename="evidence_filename" optional="show"/>
                                    <field name="evidence_filename" column_invisible="1"/>
                                    <button name="action_create_finding" type="object" string="Finding" icon="fa-exclamation-triangle" invisible="result not in ('non_compliant','partial') or finding_id"/>
                                    <field name="finding_id"/>
                                </list>
                                <form string="Checklist Response">
                                    <group>
                                        <group string="Checklist Item">
                                            <field name="sequence"/>
                                            <field name="checklist_id" options="{'no_create': True}"/>
                                            <field name="name"/>
                                            <field name="category"/>
                                            <field name="severity"/>
                                            <field name="weight"/>
                                            <field name="mandatory"/>
                                        </group>
                                        <group string="Audit Input">
                                            <field name="result"/>
                                            <field name="remarks" placeholder="Enter auditor observation / remarks..."/>
                                            <field name="evidence" filename="evidence_filename"/>
                                            <field name="evidence_filename" invisible="1"/>
                                            <field name="finding_id" readonly="1"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="requirement"/>
                                        <field name="guidance"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Findings"><field name="finding_ids" readonly="1"><list decoration-danger="is_overdue"><field name="reference"/><field name="name"/><field name="severity"/><field name="responsible_id"/><field name="deadline"/><field name="is_overdue"/><field name="state"/></list></field></page>
                        <page string="Notes"><field name="notes"/></page>
                    </notebook>
                </sheet><chatter/>
            </form>
        </field>
    </record>
    <record id="view_compliance_audit_pivot" model="ir.ui.view"><field name="name">compliance.audit.pivot</field><field name="model">compliance.audit</field><field name="arch" type="xml"><pivot string="Audit Analysis"><field name="factory_id" type="row"/><field name="audit_date" type="col" interval="month"/><field name="compliance_rate" type="measure"/></pivot></field></record>
    <record id="view_compliance_audit_graph" model="ir.ui.view"><field name="name">compliance.audit.graph</field><field name="model">compliance.audit</field><field name="arch" type="xml"><graph string="Compliance Score Trend" type="line"><field name="audit_date" interval="month"/><field name="compliance_rate" type="measure"/></graph></field></record>
</odoo>
