<odoo>
    <record id="module_category_garments_compliance" model="ir.module.category">
        <field name="name">Garments Compliance</field>
        <field name="description">Manage factory compliance, audits, findings, CAPA and registers.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_compliance_user" model="res.groups">
        <field name="name">Compliance User</field>
        <field name="category_id" ref="module_category_garments_compliance"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_compliance_manager" model="res.groups">
        <field name="name">Compliance Manager</field>
        <field name="category_id" ref="module_category_garments_compliance"/>
        <field name="implied_ids" eval="[(4, ref('group_compliance_user'))]"/>
    </record>

    <record id="rule_factory_company" model="ir.rule">
        <field name="name">Compliance Factory: company access</field>
        <field name="model_id" ref="model_compliance_factory"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_compliance_user'))]"/>
    </record>
