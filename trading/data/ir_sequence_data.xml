<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Trading Expense -->
    

    <record id="seq_trading_expense" model="ir.sequence">
            <field name="name">Trading Expense</field>
            <field name="code">trd.expense</field>
            <field name="prefix">EXP/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_trading_sales" model="ir.sequence">
            <field name="name">Trading Sales</field>
            <field name="code">trd.sales</field>
            <field name="prefix">SALES/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_trading_purchase" model="ir.sequence">
            <field name="name">Trading Purchase</field>
            <field name="code">trd.purchase</field>
            <field name="prefix">PI/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_trading_return" model="ir.sequence">
            <field name="name">Trading Return</field>
            <field name="code">trd.returns</field>
            <field name="prefix">RTN/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_trading_transaction" model="ir.sequence">
            <field name="name">Trading Transaction</field>
            <field name="code">trd.transaction</field>
            <field name="prefix">PAY/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
</odoo>