<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Application Category -->
        <record id="module_category_trading" model="ir.module.category">
            <field name="name">Trading</field>
            <field name="description">Helps you manage your trading orders, products, and customers.</field>
            <field name="sequence">10</field>
        </record>

        <!-- User Group -->
        <record id="group_trading_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_trading"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">The user will have access to his own data and can create/edit records but cannot delete them.</field>
        </record>

        <!-- Administrator Group -->
        <record id="group_trading_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="module_category_trading"/>
            <field name="implied_ids" eval="[(4, ref('group_trading_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">The administrator has full access to the trading app.</field>
        </record>
    </data>
</odoo>
