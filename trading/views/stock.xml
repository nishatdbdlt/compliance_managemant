<?xml version='1.0' encoding='utf-8'?>
<odoo>

<record id="view_stock_location_list" model="ir.ui.view">
    <field name="name">trading.stock.location.list</field>
    <field name="model">trading.stock.location</field>
    <field name="arch" type="xml">
        <list
         string="Product Categories">
            <field name="name"/>
            <field name="location_type"/>
            <field name="parent_id"/>
        </list>
    </field>
</record>


<record id="view_stock_location_form" model="ir.ui.view">
    <field name="name">trading.stock.location.form</field>
    <field name="model">trading.stock.location</field>
    <field name="arch" type="xml">
        <form string="Stock Location">
            <sheet>
                <group>
                    <field name="name"/>
                    <field name="location_type"/>
                    <field name="parent_id"/>
                </group>
            </sheet>
        </form>
    </field>
</record>

    <record id="action_stock_location" model="ir.actions.act_window">
        <field name="name">Stock locations</field>
        <field name="res_model">trading.stock.location</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
