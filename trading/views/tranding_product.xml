<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List View -->
    <record id="view_trading_product_list" model="ir.ui.view">
        <field name="name">tranding.product.list</field>
        <field name="model">tranding.product</field>
        <field name="arch" type="xml">
            <list string="Product">
                <field name="sl_no"/>
                <field name="name"/>
                <field name="price" string="cost_Price"/>
                 <field name='product_category'/>
                 <!-- <field name="percentage"/>
                 <field name="sell_price"/> -->

            </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_trading_product_form" model="ir.ui.view">
        <field name="name">tranding.product.form</field>
        <field name="model">tranding.product</field>
        <field name="arch" type="xml">
            <form string="Product">
                <sheet>
                    <group>
                        <field name="sl_no"/>
                        <field name="name"/>
                        <field name="price" string="cost_Price"/>
                        <field name='product_category'/>
                         <!-- <field name="percentage"/>
                         <field name="sell_price"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_trading_product" model="ir.actions.act_window">
        <field name="name">Product</field>
        <field name="res_model">tranding.product</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>