<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="view_customer_list" model="ir.ui.view">
        <field name="name">trading.vendor.customer.list</field>
        <field name="model">trading.vendor</field>
        <field name="arch" type="xml">
            <list string="Customers">
                <field name="sl_no"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
            </list>
        </field>
    </record>
    
    <record id="view_vendor_list" model="ir.ui.view">
        <field name="name">trading.vendor.vendor.list</field>
        <field name="model">trading.vendor</field>
        <field name="arch" type="xml">
            <list string="Vendors">
                <field name="sl_no"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="address"/>
                <field name="is_vendor"/>
                <!-- <field name="is_customer"/> -->
            </list>
        </field>
    </record>

    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">trading.vendor.customer.form</field>
        <field name="model">trading.vendor</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <group string="Customer Information">
                        <field name="sl_no"/>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                        </group>
                    <group>
                         <field name="address"/>
                        <field name="is_customer"/>
                        <!-- <field name="is_vendor"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vendor Form View -->
    <record id="view_vendor_form" model="ir.ui.view">
        <field name="name">trading.vendor.vendor.form</field>
        <field name="model">trading.vendor</field>
        <field name="arch" type="xml">
            <form string="Vendor">
                <sheet>
                    <group>
                        <field name="sl_no"/>
                        <field name="name"/>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                    <group>
                        <field name="address"/>
                        <field name="is_vendor"/>
                        <!-- <field name="is_customer"/> -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>
 <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Customers</field>
        <field name="res_model">trading.vendor</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_customer', '=', True)]</field>
        <field name="context">{'default_is_customer': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_customer_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_customer_form')}),
        ]"/>
    </record>
    
    <!-- Vendor Action -->
    <record id="action_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">trading.vendor</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_vendor', '=', True)]</field>
        <field name="context">{'default_is_vendor': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_vendor_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_vendor_form')}),
        ]"/>
    </record>

</odoo>
