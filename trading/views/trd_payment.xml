<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_list" model="ir.ui.view">
        <field name="name">trd.payment.list</field>
        <field name="model">trd.payment</field>
        <field name="arch" type="xml">
            <list string="Payments">
                <field name="Name"/>
                <field name="amount"/>
            </list>
        </field>
    </record>


    <record id="view_payment_form" model="ir.ui.view">
        <field name="name">trading.payment.form</field>
        <field name="model">trd.payment</field>
        <field name="arch" type="xml">
            <form string="Payment">
                <sheet>
                    <group>
                        <field name="Name"/>
                        <field name="amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_payment" model="ir.actions.act_window">
        <field name="name">Payments</field>
        <field name="res_model">trd.payment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>