<?xml version="1.0" encoding="utf-8"?>


<odoo>

    <!-- List View -->
    <record id="view_product_category_list" model="ir.ui.view">
        <field name="name">trd.product.category.list</field>
        <field name="model">trd.product.category</field>
        <field name="arch" type="xml">
            <list string="Product Categories">
                <field name="complete_name"/>
                 </list>
        </field>
    </record>


    <!-- Form View -->
    <record id="view_product_category_form" model="ir.ui.view">
        <field name="name">trd.product.category.form</field>
        <field name="model">trd.product.category</field>
        <field name="arch" type="xml">
            <form string="Product Category">
    <sheet>
        <group>
            <field name="name"/>
            <field name="parent_id"/>

            <field name="parent_path" invisible="1"/>
            <field name="complete_name" invisible="1"/>
        </group>
    </sheet>
</form>
        </field>
    </record>


    <!-- Action -->
    <record id="action_product_category" model="ir.actions.act_window">
        <field name="name">Product Categories</field>
        <field name="res_model">trd.product.category</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Menu -->
   

</odoo>