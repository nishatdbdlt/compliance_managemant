<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TREE VIEW -->
    <record id="view_trd_purchase_list" model="ir.ui.view">
        <field name="name">trd.purchase.list</field>
        <field name="model">trd.purchase</field>
        <field name="arch" type="xml">
            <list string="Purchases">
                <field name="Sl_no"/>
                <field name="supplier_id"/>
                <field name="total_amount" sum="Total"/>
                <field name="paid_amount" sum="Total Paid"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
                 <field name="date"/>
                <field name="Location"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_trading_purchase_form" model="ir.ui.view">
        <field name="name">trd.purchase.form</field>
        <field name="model">trd.purchase</field>
        <field name="arch" type="xml">
            <form string="Purchase">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_register_payment" string="Register Payment" type="object" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <!-- <button name="action_print_report" string="Print" type="object" class="oe_highlight" invisible="state != 'confirmed'"/> -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="Sl_no" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="supplier_id" required="1"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="Location"/>
                        </group>
                        <group>
                            <field name="total_amount" readonly="1"/>
                            <field name="paid_amount" readonly="1" widget="monetary" decoration-success="paid_amount == total_amount" decoration-warning="paid_amount &lt; total_amount and paid_amount &gt; 0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Add Product" name="order_lines">
                            <field name="purchase_line_ids" mode="list,form">
                                <list string="Add Product" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="discount"/>
                                    <field name="total" readonly="1"/>
                                </list>
                                <form string="Add Product">
                                    <group>
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price"/>
                                        <field name="discount"/>
                                        <field name="total" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <group>
                                    <field name="vendor_id"/>
                                </group>
                                <group>
                                    <!-- <field name="stock_id"/> -->
                                    <!-- <field name="payment_id"/> -->
                                    <!-- <field name="expense_id"/> -->
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_trading_purchase" model="ir.actions.act_window">
        <field name="name">Purchases</field>
        <field name="res_model">trd.purchase</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
