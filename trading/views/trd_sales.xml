<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- TREE -->
    <record id="view_trd_sales_tree" model="ir.ui.view">
        <field name="name">trd.sales.tree</field>
        <field name="model">trd.sales</field>
        <field name="arch" type="xml">
            <list string="Sales">
                <field name="Sl_no"/>
                <field name="customer_id"/>
                <field name="total_amount"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_trading_sales_form" model="ir.ui.view">
        <field name="name">trd.sales.form</field>
        <field name="model">trd.sales</field>
        <field name="arch" type="xml">
            <form string="Sales">
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="Sl_no" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_id" required="1"/>
                        </group>
                        <group>
                            <field name="total_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Add Product" name="order_lines">
                            <field name="sale_line_ids" mode="list,form">
                                <list string="Add Product" editable="bottom">
                                    <!-- <field name="sl_no"/> -->
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price"/>
                                    <field name="discount"/>
                                    <field name="total" readonly="1"/>
                                </list>
                                <form string="Add Product">
                                    <group>
                                        <!-- <field name="sl_no"/> -->
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="price"/>
                                        <field name="discount"/>
                                        <field name="total" readonly="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <group>
                                    <field name="vendor_id"/>
                                    <field name="category_id"/>
                                </group>
                                <group>
                                    <field name="stock_id"/>
                                    <field name="payment_id"/>
                                    <field name="expense_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_trading_sales" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">trd.sales</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
