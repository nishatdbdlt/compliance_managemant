<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- TREE -->
    <record id="view_trd_sales_tree" model="ir.ui.view">
        <field name="name">trd.sales.tree</field>
        <field name="model">trd.sales</field>
        <field name="arch" type="xml">
            <list string="Sales">
                <field name="Sl_no"/>
                <field name="name"/>
                <field name="product"/>
                <field name="quantity"/>
                <field name="price"/>
                <field name="total"/>
                <field name="vendor_id"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_trading_sales_form" model="ir.ui.view">
        <field name="name">trd.sales.form</field>
        <field name="model">trd.sales</field>
        <field name="arch" type="xml">
            <form string="Sales">
                <sheet>
                    <group>
                      <field name="Sl_no"/>
                      <field name="name"/>
                     <field name="product"/>
                    </group>

                    <group>
                        <field name="quantity"/>
                        <field name="price"/>
                        <field name="total" readonly="1"/>
                    </group>

                    <group string="Relations">
                        <field name="vendor_id"/>
                        <field name="category_id"/>
                        <field name="stock_id"/>
                        <field name="payment_id"/>
                        <field name="expense_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_trading_sales" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">trd.sales</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
