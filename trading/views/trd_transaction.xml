<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_transaction_list" model="ir.ui.view">
        <field name="name">trd.transaction.list</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions" decoration-info="state == 'draft'" decoration-success="state == 'paid'" decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="payment_method_id"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'paid'" decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">trd.transaction.form</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <button name="action_paid" string="Mark as Paid" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_draft" string="Reset to Draft" type="object" invisible="state != 'cancel'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ['draft', 'paid']"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="payment_method_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="payment_date" readonly="state != 'draft'"/>
                            <field name="sale_id" domain="[('customer_id', '=', partner_id), ('state', '=', 'confirmed')]" readonly="state != 'draft'"/>
                            <field name="purchase_id" domain="[('supplier_id', '=', partner_id), ('state', '=', 'confirmed')]" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">trd.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
