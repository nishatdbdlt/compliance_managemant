<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_transaction_list" model="ir.ui.view">
        <field name="name">trd.transaction.list</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'paid'"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="payment_method_id"/>
                <field name="amount" string="Total Amount" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">trd.transaction.form</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <button name="action_paid"
                            string="Mark as Fully Paid"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('cancel', 'paid')"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'paid')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,paid"/>
                </header>

                <sheet>


                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <!-- Left: basic info -->
                        <group string="Transaction Info">
                            <field name="partner_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="payment_method_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="payment_date"
                                   readonly="state not in ('draft',)"/>
                            <field name="sale_id"
                                   domain="[('customer_id', '=', partner_id), ('state', '=', 'confirmed')]"
                                   readonly="state not in ('draft',)"/>
                            <field name="purchase_id"
                                   domain="[('supplier_id', '=', partner_id), ('state', '=', 'confirmed')]"
                                   readonly="state not in ('draft',)"/>
                        </group>

                        <!-- Right: amounts -->
                        <group string="Payment">
                            <field name="amount"
                                   readonly="state not in ('draft',)"/>
                        </group>
                    </group>
                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_transaction_search" model="ir.ui.view">
        <field name="name">trd.transaction.search</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <search string="Transactions">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Draft"           name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Paid"            name="filter_paid"  domain="[('state','=','paid')]"/>
                <separator/>
                <filter string="My Transactions" name="filter_my"
                        domain="[('create_uid','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status"  name="group_state"   context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         WINDOW ACTION
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">trd.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transaction_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
    </record>

</odoo>