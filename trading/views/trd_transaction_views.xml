<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════
         LIST VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_transaction_list" model="ir.ui.view">
        <field name="name">trd.transaction.list</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <list string="Transactions"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'due'"
                  decoration-success="state == 'paid'"
                  decoration-danger="state == 'cancel'">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="partner_id"/>
                <field name="payment_method_id"/>
                <field name="amount"      string="Total Amount" sum="Total"/>
                <field name="paid_amount" string="Total Paid"   sum="Paid"/>
                <field name="due_amount"  string="Due Amount"   sum="Due"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'due'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         FORM VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_transaction_form" model="ir.ui.view">
        <field name="name">trd.transaction.form</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <form string="Transaction">
                <header>
                    <!-- Draft → Paid / Due -->
                    <button name="action_paid"
                            string="Confirm Payment"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <!-- Due → pay remaining or partial more -->
                    <button name="action_pay_due"
                            string="Pay Due Amount"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'due'"/>

                    <button name="action_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state not in ('cancel', 'paid', 'due')"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'paid', 'due')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,due,paid"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <!-- Left: basic info -->
                        <group string="Transaction Info">
                            <field name="partner_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="payment_method_id"
                                   readonly="state not in ('draft',)"/>
                            <field name="payment_date"
                                   readonly="state not in ('draft',)"/>
                            <field name="sale_id"
                                   domain="[('customer_id', '=', partner_id), ('state', '=', 'confirmed')]"
                                   readonly="state not in ('draft',)"/>
                            <field name="purchase_id"
                                   domain="[('supplier_id', '=', partner_id), ('state', '=', 'confirmed')]"
                                   readonly="state not in ('draft',)"/>
                        </group>

                        <!-- Right: amounts -->
                        <group string="Payment">
                            <!-- Total invoice amount -->
                            <field name="amount"
                                   string="Total Amount"
                                   readonly="state not in ('draft',)"/>

                            <!-- DRAFT: user enters how much they are paying now.
                                 0 = pay in full on confirm. -->
                            <field name="initial_payment"
                                   string="Paying Now (0 = pay in full)"
                                   invisible="state != 'draft'"
                                   help="Enter how much you are paying now. Leave 0 to pay the full amount at once."/>

                            <!-- DUE state: show running totals (all readonly) -->
                            <field name="paid_amount"
                                   string="Total Paid So Far"
                                   readonly="1"
                                   invisible="state == 'draft'"/>
                            <field name="due_amount"
                                   string="Remaining Due"
                                   readonly="1"
                                   invisible="state == 'draft'"/>

                            <!-- DUE: optional extra partial payment.
                                 Leave 0 to clear the full remaining due. -->
                            <field name="due_payment_amount"
                                   string="Pay Now (leave 0 to clear full due)"
                                   invisible="state != 'due'"
                                   help="Enter how much you are paying now toward the due. Leave 0 to pay the full remaining due at once."/>
                        </group>
                    </group>

                    <!-- Due banner -->
                    <div class="alert alert-warning" role="alert"
                         invisible="state != 'due'">
                        <strong>&#9888; Outstanding Due:</strong>
                        <field name="due_amount" readonly="1" nolabel="1" class="oe_inline"/> remaining.
                        Click <strong>Pay Due Amount</strong> to clear it
                        (or enter a partial amount in <em>Pay Now</em> first).
                    </div>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         SEARCH VIEW
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="view_transaction_search" model="ir.ui.view">
        <field name="name">trd.transaction.search</field>
        <field name="model">trd.transaction</field>
        <field name="arch" type="xml">
            <search string="Transactions">
                <field name="name"/>
                <field name="partner_id"/>
                <filter string="Draft"         name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Due (Partial)" name="filter_due"   domain="[('state','=','due')]"/>
                <filter string="Paid"          name="filter_paid"  domain="[('state','=','paid')]"/>
                <separator/>
                <filter string="My Transactions" name="filter_my"
                        domain="[('create_uid','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Partner" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status"  name="group_state"   context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ══════════════════════════════════════════════════════════════════
         WINDOW ACTION
    ═══════════════════════════════════════════════════════════════════════ -->
    <record id="action_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">trd.transaction</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_transaction_search"/>
        <field name="context">{'search_default_filter_draft': 0}</field>
    </record>

</odoo>