<odoo>
    <record id="view_compliance_finding_search" model="ir.ui.view">
        <field name="name">compliance.finding.search</field><field name="model">compliance.finding</field>
        <field name="arch" type="xml"><search><field name="reference"/><field name="name"/><field name="audit_id" filter_domain="[('audit_id','=',self)]"/><field name="responsible_id"/><filter string="Open" name="open" domain="[('state','!=','closed')]"/><filter string="Overdue" name="overdue" domain="[('is_overdue','=',True)]"/><separator/><filter string="Severity" name="group_severity" context="{'group_by':'severity'}"/><filter string="Responsible" name="group_responsible" context="{'group_by':'responsible_id'}"/><filter string="Status" name="group_state" context="{'group_by':'state'}"/></search></field>
    </record>
    <record id="view_compliance_finding_list" model="ir.ui.view"><field name="name">compliance.finding.list</field><field name="model">compliance.finding</field><field name="arch" type="xml"><list decoration-danger="is_overdue or severity == 'critical'" decoration-warning="state != 'closed' and not is_overdue"><field name="reference"/><field name="name"/><field name="audit_id"/><field name="severity" widget="badge"/><field name="responsible_id"/><field name="deadline"/><field name="days_overdue" optional="show"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_compliance_finding_form" model="ir.ui.view"><field name="name">compliance.finding.form</field><field name="model">compliance.finding</field><field name="arch" type="xml">
        <form><header><button name="action_analyze" type="object" string="Root Cause Analysis" invisible="state not in ('open','reopened')"/><button name="action_start_action" type="object" string="Start Action" class="btn-primary" invisible="state != 'analysis'"/><button name="action_verify" type="object" string="Submit for Verification" invisible="state != 'action'"/><button name="action_close" type="object" string="Close Finding" class="btn-primary" invisible="state != 'verification'" groups="garments_compliance.group_compliance_manager"/><button name="action_reopen" type="object" string="Reopen" invisible="state not in ('closed','verification')" groups="garments_compliance.group_compliance_manager"/><field name="state" widget="statusbar" statusbar_visible="open,analysis,action,verification,closed"/></header>
        <sheet><div class="oe_title"><h1><field name="name"/></h1><h3><field name="reference" readonly="1"/></h3></div><group><group><field name="audit_id"/><field name="audit_line_id"/><field name="severity"/><field name="responsible_id"/></group><group><field name="deadline"/><field name="is_overdue" readonly="1"/><field name="days_overdue" readonly="1"/><field name="evidence" filename="evidence_filename"/><field name="evidence_filename" invisible="1"/></group></group><group><field name="description"/><field name="root_cause"/><field name="corrective_action"/><field name="preventive_action"/></group><notebook><page string="CAPA"><field name="capa_ids"><list editable="bottom" decoration-danger="is_overdue"><field name="reference"/><field name="name"/><field name="action_type"/><field name="responsible_id"/><field name="deadline"/><field name="is_overdue"/><field name="state"/></list></field></page></notebook></sheet><chatter/></form>
    </field></record>
    <record id="view_compliance_finding_pivot" model="ir.ui.view"><field name="name">compliance.finding.pivot</field><field name="model">compliance.finding</field><field name="arch" type="xml"><pivot><field name="severity" type="row"/><field name="state" type="col"/><field name="id" type="measure"/></pivot></field></record>

    <record id="view_compliance_capa_list" model="ir.ui.view"><field name="name">compliance.capa.list</field><field name="model">compliance.capa</field><field name="arch" type="xml"><list decoration-danger="is_overdue"><field name="reference"/><field name="name"/><field name="finding_id"/><field name="action_type"/><field name="responsible_id"/><field name="deadline"/><field name="completion_date" optional="hide"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_compliance_capa_form" model="ir.ui.view"><field name="name">compliance.capa.form</field><field name="model">compliance.capa</field><field name="arch" type="xml"><form><header><button name="action_start" type="object" string="Start" invisible="state not in ('draft','reopened')"/><button name="action_submit" type="object" string="Submit for Verification" class="btn-primary" invisible="state != 'in_progress'"/><button name="action_verify" type="object" string="Verify &amp; Close" class="btn-primary" invisible="state != 'to_verify'" groups="garments_compliance.group_compliance_manager"/><button name="action_reopen" type="object" string="Reopen" invisible="state != 'done'" groups="garments_compliance.group_compliance_manager"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1><h3><field name="reference"/></h3></div><group><group><field name="finding_id"/><field name="action_type"/><field name="responsible_id"/></group><group><field name="deadline"/><field name="completion_date"/><field name="is_overdue"/></group></group><field name="description"/><group><field name="evidence" filename="evidence_filename"/><field name="evidence_filename" invisible="1"/></group><field name="verification_notes"/></sheet><chatter/></form></field></record>
</odoo>
