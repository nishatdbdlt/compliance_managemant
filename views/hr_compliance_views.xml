<odoo>
    <record id="view_compliance_hr_compliance_list" model="ir.ui.view">
        <field name="name">compliance.hr.compliance.list</field>
        <field name="model">compliance.hr.compliance</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue" decoration-success="state in ('compliant','closed')">
                <field name="name"/><field name="factory_id"/><field name="employee_id"/><field name="compliance_type"/>
                <field name="responsible_id"/><field name="due_date"/><field name="is_overdue"/><field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_compliance_hr_compliance_form" model="ir.ui.view">
        <field name="name">compliance.hr.compliance.form</field><field name="model">compliance.hr.compliance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_require_action" type="object" string="Action Required" invisible="state not in ('open','compliant')"/>
                    <button name="action_compliant" type="object" string="Mark Compliant" class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_close" type="object" string="Close" invisible="state not in ('compliant','action')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet><div class="oe_title"><h1><field name="name"/></h1></div>
                    <group><group><field name="company_id" groups="base.group_multi_company"/><field name="factory_id"/><field name="employee_id"/><field name="compliance_type"/></group>
                    <group><field name="responsible_id"/><field name="due_date"/><field name="is_overdue" readonly="1"/></group></group>
                    <group string="Requirement &amp; Observation"><field name="requirement"/><field name="observation"/></group>
                    <group string="Evidence"><field name="evidence" filename="evidence_filename"/><field name="evidence_filename" invisible="1"/></group>
                </sheet><chatter/>
            </form>
        </field>
    </record>
</odoo>
