<odoo>
    <record id="view_compliance_license_list" model="ir.ui.view"><field name="name">compliance.license.list</field><field name="model">compliance.license</field><field name="arch" type="xml"><list decoration-danger="status == 'expired'" decoration-warning="status == 'expiring'"><field name="name"/><field name="license_type"/><field name="license_number"/><field name="factory_id"/><field name="expiry_date"/><field name="days_to_expiry"/><field name="responsible_id"/><field name="status" widget="badge"/></list></field></record>
    <record id="view_compliance_license_form" model="ir.ui.view"><field name="name">compliance.license.form</field><field name="model">compliance.license</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="factory_id"/><field name="license_type"/><field name="license_number"/></group><group><field name="issue_date"/><field name="expiry_date"/><field name="days_to_expiry" readonly="1"/><field name="status" widget="badge" readonly="1"/><field name="responsible_id"/></group></group><field name="attachment" filename="attachment_filename"/><field name="attachment_filename" invisible="1"/><field name="notes"/></sheet><chatter/></form></field></record>

    <record id="view_compliance_safety_list" model="ir.ui.view"><field name="name">compliance.safety.inspection.list</field><field name="model">compliance.safety.inspection</field><field name="arch" type="xml"><list><field name="name"/><field name="factory_id"/><field name="inspection_type"/><field name="inspection_date"/><field name="inspector_id"/><field name="result" widget="badge"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_compliance_safety_form" model="ir.ui.view"><field name="name">compliance.safety.inspection.form</field><field name="model">compliance.safety.inspection</field><field name="arch" type="xml"><form><header><button name="action_mark_done" type="object" string="Mark Done" class="btn-primary" invisible="state != 'planned'"/><button name="action_close" type="object" string="Close" invisible="state not in ('done','action_required')"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="factory_id"/><field name="inspection_type"/></group><group><field name="inspection_date"/><field name="inspector_id"/><field name="result"/><field name="action_owner_id"/><field name="due_date"/></group></group><field name="findings"/><field name="evidence" filename="evidence_filename"/><field name="evidence_filename" invisible="1"/></sheet><chatter/></form></field></record>

    <record id="view_compliance_training_list" model="ir.ui.view"><field name="name">compliance.training.list</field><field name="model">compliance.training</field><field name="arch" type="xml"><list><field name="name"/><field name="training_type"/><field name="factory_id"/><field name="training_date"/><field name="participant_count"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_compliance_training_form" model="ir.ui.view"><field name="name">compliance.training.form</field><field name="model">compliance.training</field><field name="arch" type="xml"><form><header><button name="action_done" type="object" string="Mark Completed" class="btn-primary" invisible="state != 'planned'"/><button name="action_cancel" type="object" string="Cancel" invisible="state != 'planned'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="factory_id"/><field name="training_type"/><field name="training_date"/></group><group><field name="trainer"/><field name="participant_count" readonly="1"/><field name="duration_hours"/></group></group><field name="employee_ids" widget="many2many_tags"/><field name="notes"/><field name="evidence" filename="evidence_filename"/><field name="evidence_filename" invisible="1"/></sheet><chatter/></form></field></record>

    <record id="view_compliance_document_list" model="ir.ui.view"><field name="name">compliance.document.list</field><field name="model">compliance.document</field><field name="arch" type="xml"><list><field name="name"/><field name="document_type"/><field name="version"/><field name="factory_id"/><field name="owner_id"/><field name="issue_date"/><field name="review_date"/><field name="state" widget="badge"/></list></field></record>
    <record id="view_compliance_document_form" model="ir.ui.view"><field name="name">compliance.document.form</field><field name="model">compliance.document</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="company_id" groups="base.group_multi_company"/><field name="factory_id"/><field name="document_type"/><field name="version"/></group><group><field name="owner_id"/><field name="issue_date"/><field name="review_date"/><field name="state"/></group></group><field name="attachment" filename="attachment_filename"/><field name="attachment_filename" invisible="1"/><field name="notes"/></sheet><chatter/></form></field></record>
</odoo>
